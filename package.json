{
  "name": "@ylcnfrht/collections",
  "version": "1.0.1",
  "description": "Collections framework for TypeScript and JS, inspired by Java's Collections Framework and Stream API: ArrayList, LinkedList, HashMap, TreeMap, PriorityQueue, Stream and more, with value equality, fail-fast iterators and live views.",
  "keywords": [
    "collections",
    "data-structures",
    "arraylist",
    "linkedlist",
    "hashmap",
    "treemap",
    "treeset",
    "priorityqueue",
    "deque",
    "stream",
    "collectors",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "ylcnfrht",
    "url": "https://github.com/ylcnfrht"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylcnfrht/collections.git"
  },
  "homepage": "https://ylcnfrht.github.io/collections/",
  "bugs": {
    "url": "https://github.com/ylcnfrht/collections/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:diff": "ts-node --transpile-only -P tsconfig.test.json tools/differential/main.ts --count 20000 --batch 5000",
    "test:diff:proof": "ts-node --transpile-only -P tsconfig.test.json tools/differential/proof.ts --scripts 200000 --batch 5000",
    "bench": "ts-node --transpile-only -P tsconfig.test.json bench/index.ts",
    "bench:isolated": "ts-node --transpile-only -P tsconfig.test.json bench/isolated/run-all.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "tinybench": "6.2.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "8.5.1",
    "typedoc": "0.28.20",
    "typescript": "^5.8.3"
  }
}
