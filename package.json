{
  "name": "ts-collections-framework",
  "version": "1.0.0",
  "description": "Collections framework for TypeScript: ArrayList, LinkedList, HashMap, TreeMap, PriorityQueue and more, with value equality, fail-fast iterators and live views.",
  "keywords": [
    "collections",
    "data-structures",
    "arraylist",
    "linkedlist",
    "hashmap",
    "treemap",
    "treeset",
    "priorityqueue",
    "deque",
    "stream",
    "collectors",
    "typescript"
  ],
  "license": "MIT",
  "author": "baims <tech@baims.com>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:diff": "ts-node --transpile-only -P tsconfig.test.json tools/differential/main.ts --count 20000 --batch 5000",
    "test:diff:proof": "ts-node --transpile-only -P tsconfig.test.json tools/differential/proof.ts --scripts 200000 --batch 5000",
    "bench": "ts-node --transpile-only -P tsconfig.test.json bench/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@datastructures-js/priority-queue": "6.4.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "js-sdsl": "4.4.2",
    "mnemonist": "0.40.5",
    "tinybench": "6.2.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "8.5.1",
    "typescript": "^5.8.3"
  }
}
